{
  "name": "ezlol-app",
  "productName": "ezlol",
  "version": "1.0.3",
  "description": "League of Legends queue auto-accept and build viewer",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.16.0"
  },
  "build": {
    "appId": "dev.arlint.ezlol",
    "productName": "ezlol",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "icon.png"],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.games",
      "target": ["dmg", "zip"],
      "icon": "icon.png",
      "darkModeSupport": true,
      "extraResources": [
        { "from": "../bin/ezlol", "to": "ezlol" },
        { "from": "../bin/ezlol-ocr", "to": "ezlol-ocr" }
      ],
      "extendInfo": { "NSScreenCaptureUsageDescription": "ezlol reads the augment selection screen to recommend a pick." }
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "icon.png",
      "extraResources": [{ "from": "../bin/ezlol.exe", "to": "ezlol.exe" }]
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "portable": { "artifactName": "${productName}-${version}-${os}-${arch}-portable.${ext}" }
  }
}
